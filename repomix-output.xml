      : <span style={{ fontFamily: 'Bebas Neue, sans-serif', fontSize: '1.6rem', color: primary, letterSpacing: 2 }}>{name}</span>
  }
  if (layout === 'logo-name-side') {
    return (
      <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
